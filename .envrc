# -*- mode: sh; -*-
export DIRENV_WARN_TIMEOUT=20s

# This machine's ~/.ssh/config sets IdentitiesOnly yes and IdentityAgent none
# for every host except github.com, so OpenSSH (and therefore Ansible) never
# offers the disposable agent key. Ansible's command-line options win over the
# host config and identities are additive, so name the key explicitly. This
# replaces the generated ssh_args, so it repeats them.
export ANSIBLE_SSH_ARGS="-o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o ForwardAgent=yes -o IdentityFile=/home/ubuntu/code/getcolors/once-vultr/.ssh/id_ed25519"

eval "$(devenv direnvrc)"
use devenv 2>/dev/null

source_env_if_exists .envrc.private
